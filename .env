# debug
DEBUG_LOGGING=false

# backends (comma separated)
LLM_BACKEND_URLS=http://localhost:8080/v1/chat/completions

# session & limits
SESSION_TTL_SECONDS=3600
MAX_LRU_SESSIONS=5000
MAX_MESSAGES=64
MAX_MESSAGE_LENGTH=4000

# upstream / client
UPSTREAM_TIMEOUT=60.0
UPSTREAM_RETRIES=2

# model context / governor
MAX_MODEL_CONTEXT=8192
REANCHOR_COOLDOWN=45.0
MAX_REANCHORS_PER_SESSION=3

# http client pool tuning
HTTP_MAX_KEEPALIVE=50
HTTP_MAX_CONNECTIONS=200

# local runtime port (optional)
PORT=8000