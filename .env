# ==========================================
# Anti-Entropy Cognitive Middleware Environment Configuration
# ==========================================

# Server Configuration
PORT=8000

# Upstream LLM Backend Endpoints (Comma-separated for multi-backend failover and circuit breaker)
LLM_BACKEND_URLS=http://localhost:8080/v1/chat/completions,http://localhost:8081/v1/chat/completions

# Session Management & LRU Cache Settings
SESSION_TTL_SECONDS=3600
MAX_LRU_SESSIONS=5000

# Context Constraints & Memory Layer Limits
MAX_MESSAGES=64
MAX_MESSAGE_LENGTH=4000

# Upstream Connection Parameters
UPSTREAM_TIMEOUT=60.0
UPSTREAM_RETRIES=2